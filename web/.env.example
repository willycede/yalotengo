# Copy to .env and adjust. Vite inlines VITE_* at build time — never put secrets here.

# Backend URL.
#   PC:               http://localhost:3000
#   Celular en LAN:   http://<ip-de-tu-pc>:3000
VITE_API_URL=http://localhost:3000

# Moneda y formato del precio unitario (opcional).
VITE_CURRENCY=USD
VITE_LOCALE=es-EC
