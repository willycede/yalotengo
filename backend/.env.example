NODE_ENV=development
PORT=3000

# PostgreSQL connection (Railway provides DATABASE_URL directly)
DATABASE_URL=postgresql://user:password@localhost:5432/yalotengo

# JWT
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=*

# Railway Bucket (S3-compatible) para las fotos de productos.
#
# En Railway: Create -> Bucket, conectalo al servicio y copia sus credenciales.
# El backend tambien acepta los nombres que Railway inyecta por defecto
# (ENDPOINT, REGION, BUCKET, ACCESS_KEY_ID, SECRET_ACCESS_KEY), asi que en
# produccion no hace falta renombrarlas.
#
# Dejalas vacias para desarrollar sin fotos: la API arranca igual y solo
# la subida de imagenes queda deshabilitada.
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
